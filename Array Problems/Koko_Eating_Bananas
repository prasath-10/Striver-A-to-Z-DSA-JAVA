class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int max = 0 , min = Integer.MAX_VALUE;
        for(int num : piles){
            if(num > max){
                max = num;
            }
        }
        System.out.println(max);
        int left = 1;
        int right = max;
        while(left <= right){
            int mid = left + (right - left) / 2;
            long  hours = 0;
            for(int  i = 0 ; i < piles.length ; i++)
            {
                 hours += (long) Math.ceil((double) piles[i] / mid);
            }
            if(hours <= h){
                min = mid;
                right = mid - 1;
            }
            else{
                left = mid + 1;
            }
        }
        return min;
    }
}
